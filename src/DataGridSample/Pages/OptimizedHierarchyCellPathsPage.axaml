<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:DataGridSample.Behaviors"
             xmlns:models="clr-namespace:DataGridSample.Models"
             xmlns:viewModels="clr-namespace:DataGridSample.ViewModels"
             x:Class="DataGridSample.Pages.OptimizedHierarchyCellPathsPage"
             x:DataType="viewModels:OptimizedHierarchyCellPathsViewModel"
             behaviors:DataContextFactoryBehavior.Factory="{StaticResource OptimizedHierarchyCellPathsViewModelFactory}"
             d:DesignHeight="780"
             d:DesignWidth="1240"
             mc:Ignorable="d">
  <UserControl.Resources>
    <viewModels:OptimizedHierarchyCellPathsViewModelFactory x:Key="OptimizedHierarchyCellPathsViewModelFactory" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGrid.optimized-cell-path">
      <Setter Property="RowTheme" Value="{StaticResource DataGridOptimizedFeatureUnfrozenRowTheme}" />
      <Setter Property="CellTheme" Value="{StaticResource DataGridOptimizedCellTheme}" />
      <Setter Property="ColumnHeaderTheme" Value="{StaticResource DataGridOptimizedFeatureColumnHeaderTheme}" />
      <Setter Property="UseLightweightFiller" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="8">
    <StackPanel Spacing="3">
      <TextBlock Classes="h2" Text="Optimized Cell Paths — Hierarchical Workload" />
      <TextBlock TextWrapping="Wrap"
                 Text="Switch one live hierarchical grid between the standard presenter, optimized retained presenter, direct retained hierarchy, and drawn companion-cell paths. The default target contains 149,792 nodes; roots begin expanded so expansion and scrolling can be assessed separately." />
    </StackPanel>

    <WrapPanel Grid.Row="1" Orientation="Horizontal">
      <TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="Cell path" />
      <ComboBox Width="270"
                Margin="0,0,14,8"
                ItemsSource="{CompiledBinding Paths}"
                SelectedItem="{CompiledBinding SelectedPath, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:OptimizedCellPathOption">
            <TextBlock Text="{CompiledBinding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Margin="0,0,4,8" VerticalAlignment="Center" Text="Roots" />
      <NumericUpDown Width="74"
                     Margin="0,0,8,8"
                     Minimum="1"
                     Maximum="128"
                     Value="{CompiledBinding RootCount, Mode=TwoWay}" />
      <TextBlock Margin="0,0,4,8" VerticalAlignment="Center" Text="Branch" />
      <NumericUpDown Width="68"
                     Margin="0,0,8,8"
                     Minimum="2"
                     Maximum="12"
                     Value="{CompiledBinding BranchingFactor, Mode=TwoWay}" />
      <TextBlock Margin="0,0,4,8" VerticalAlignment="Center" Text="Depth" />
      <NumericUpDown Width="68"
                     Margin="0,0,8,8"
                     Minimum="1"
                     Maximum="5"
                     Value="{CompiledBinding Depth, Mode=TwoWay}" />
      <Button Margin="0,0,10,8"
              Content="Load workload"
              Command="{CompiledBinding LoadRepresentativeWorkloadCommand}" />
      <TextBlock Margin="0,0,14,8" VerticalAlignment="Center" Text="{CompiledBinding TargetNodeSummary}" />

      <Button Margin="0,0,6,8" Content="Expand all" Command="{CompiledBinding ExpandAllCommand}" />
      <Button Margin="0,0,12,8" Content="Collapse all" Command="{CompiledBinding CollapseAllCommand}" />
      <Button Margin="0,0,6,8" Content="First" Command="{CompiledBinding JumpToFirstCommand}" />
      <Button Margin="0,0,6,8" Content="Middle" Command="{CompiledBinding JumpToMiddleCommand}" />
      <Button Margin="0,0,12,8" Content="Last" Command="{CompiledBinding JumpToLastCommand}" />
      <Button Margin="0,0,8,8"
              Content="Refresh heap snapshot"
              Command="{CompiledBinding RefreshManagedMemoryCommand}" />
    </WrapPanel>

    <Border Grid.Row="2"
            Padding="10,8"
            Background="#08000000"
            CornerRadius="5">
      <Grid ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="2">
        <TextBlock FontWeight="SemiBold" Text="Container" />
        <TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPath.Container}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Configuration" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{CompiledBinding SelectedPath.Configuration}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Purpose" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{CompiledBinding SelectedPath.Description}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{CompiledBinding Summary}" />
          <TextBlock Text="{CompiledBinding VisibleNodeSummary}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{CompiledBinding ManagedMemorySummary}" />
          <TextBlock FontStyle="Italic"
                     Opacity="0.72"
                     Text="Expand/collapse timing is model dispatch only; use DevTools or the benchmark harness for layout/render measurements." />
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid x:Name="OptimizedHierarchyCellPathsGrid"
              Grid.Row="3"
              AutomationProperties.Name="Optimized hierarchical cell paths workload grid"
              AutoGenerateColumns="False"
              AutoScrollToSelectedItem="True"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              Classes.hierarchical="True"
              Classes.optimized-cell-path="{CompiledBinding UseOptimizedTheme}"
              ColumnDefinitionsSource="{CompiledBinding ActiveColumns}"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              HierarchicalModel="{CompiledBinding Model}"
              HierarchicalRowsEnabled="True"
              IsReadOnly="True"
              RowHeight="28"
              SelectedItem="{CompiledBinding SelectedItem, Mode=TwoWay}"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              UseLogicalScrollable="True" />
  </Grid>
</UserControl>
