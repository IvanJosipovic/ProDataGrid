<UserControl
    x:Class="DataGridSample.Pages.GeneratedOperationsControllerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    xmlns:pages="clr-namespace:DataGridSample.Pages"
    xmlns:viewModels="clr-namespace:DataGridSample.ViewModels"
    x:DataType="viewModels:GeneratedOperationsControllerViewModel">
  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
    <StackPanel Spacing="4">
      <TextBlock Classes="h2" Text="Generated operations controller" />
      <TextBlock TextWrapping="Wrap"
                 Text="Typed generated fields drive local sorting, filtering, searching, and reusable presets without reflection or property-path switches." />
    </StackPanel>
    <WrapPanel Grid.Row="1">
      <Button Content="Warsaw high value preset" Command="{Binding ApplyRiskPresetCommand}" />
      <Button Content="Clear operations" Command="{Binding ClearOperationsCommand}" />
      <Button Content="Add row" Command="{Binding AddRowCommand}" />
    </WrapPanel>
    <Border Grid.Row="2" Padding="8" Background="{DynamicResource ThemeControlLowBrush}" CornerRadius="4">
      <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
    </Border>
    <ItemsControl Grid.Row="3" ItemsSource="{Binding OperationsDescriptors}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="grid:DataGridGeneratedOperationDescriptor">
          <Border Margin="0,0,6,0" Padding="8,3" CornerRadius="10"
                  Background="{DynamicResource ThemeControlMidBrush}">
            <TextBlock Text="{Binding Summary}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <pages:GeneratedOperationsControllerGrid Grid.Row="4" />
  </Grid>
</UserControl>
