<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DataGridSample.ViewModels"
             x:Class="DataGridSample.Pages.CustomDrawingEditingPage"
             x:DataType="viewModels:CustomDrawingEditingViewModel">
  <UserControl.DataContext>
    <viewModels:CustomDrawingEditingViewModel />
  </UserControl.DataContext>

  <Grid RowDefinitions="Auto,Auto,*"
        RowSpacing="12"
        Margin="12">
    <StackPanel Spacing="4">
      <TextBlock Classes="h2">Custom Drawing Columns (Editing)</TextBlock>
      <TextBlock Text="ID and Title use the built-in numeric/text drawn display mode; Notes and Category use custom Skia draw operations. All editable columns materialize the normal retained editor only while editing. Double-click a Title, Notes, or Category cell, or press F2."
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
      <Button Content="Add Row"
              Command="{Binding AddRowCommand}" />
      <Button Content="Reset Rows"
              Command="{Binding ResetRowsCommand}" />
    </StackPanel>

    <DataGrid Grid.Row="2"
              ItemsSource="{CompiledBinding Rows}"
              ColumnDefinitionsSource="{CompiledBinding ColumnDefinitions}"
              FastPathOptions="{CompiledBinding FastPathOptions}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              IsReadOnly="False"
              RowBackground="#08000000"
              GridLinesVisibility="Horizontal" />
  </Grid>
</UserControl>
