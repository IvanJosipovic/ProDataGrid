<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:DataGridSample.Behaviors"
             xmlns:models="clr-namespace:DataGridSample.Models"
             xmlns:viewModels="clr-namespace:DataGridSample.ViewModels"
             x:Class="DataGridSample.Pages.OptimizedFlatCellPathsPage"
             x:DataType="viewModels:OptimizedFlatCellPathsViewModel"
             behaviors:DataContextFactoryBehavior.Factory="{StaticResource OptimizedFlatCellPathsViewModelFactory}"
             d:DesignHeight="760"
             d:DesignWidth="1200"
             mc:Ignorable="d">
  <UserControl.Resources>
    <viewModels:OptimizedFlatCellPathsViewModelFactory x:Key="OptimizedFlatCellPathsViewModelFactory" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGrid.optimized-cell-path">
      <Setter Property="RowTheme" Value="{StaticResource DataGridOptimizedFeatureUnfrozenRowTheme}" />
      <Setter Property="CellTheme" Value="{StaticResource DataGridOptimizedCellTheme}" />
      <Setter Property="ColumnHeaderTheme" Value="{StaticResource DataGridOptimizedFeatureColumnHeaderTheme}" />
      <Setter Property="UseLightweightFiller" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="8">
    <StackPanel Spacing="3">
      <TextBlock Classes="h2" Text="Optimized Cell Paths — Flat Workload" />
      <TextBlock TextWrapping="Wrap"
                 Text="Switch one live grid between every retained, direct, built-in drawn, and custom-drawn display path. The default target is 250,000 immutable rows with seven columns. Use a fresh process and the same window size for meaningful manual comparisons." />
    </StackPanel>

    <WrapPanel Grid.Row="1" Orientation="Horizontal">
      <TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="Cell path" />
      <ComboBox Width="245"
                Margin="0,0,14,8"
                ItemsSource="{CompiledBinding Paths}"
                SelectedItem="{CompiledBinding SelectedPath, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:OptimizedCellPathOption">
            <TextBlock Text="{CompiledBinding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="Rows" />
      <NumericUpDown Width="125"
                     Margin="0,0,8,8"
                     Minimum="1000"
                     Maximum="1000000"
                     Increment="25000"
                     Value="{CompiledBinding TargetRowCount, Mode=TwoWay}" />
      <Button Margin="0,0,14,8"
              Content="Load workload"
              Command="{CompiledBinding LoadRepresentativeWorkloadCommand}" />

      <Button Margin="0,0,6,8" Content="First" Command="{CompiledBinding JumpToFirstCommand}" />
      <Button Margin="0,0,6,8" Content="Middle" Command="{CompiledBinding JumpToMiddleCommand}" />
      <Button Margin="0,0,14,8" Content="Last" Command="{CompiledBinding JumpToLastCommand}" />
      <Button Margin="0,0,8,8"
              Content="Refresh heap snapshot"
              Command="{CompiledBinding RefreshManagedMemoryCommand}" />
    </WrapPanel>

    <Border Grid.Row="2"
            Padding="10,8"
            Background="#08000000"
            CornerRadius="5">
      <Grid ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="2">
        <TextBlock FontWeight="SemiBold" Text="Container" />
        <TextBlock Grid.Column="1" Text="{CompiledBinding SelectedPath.Container}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Configuration" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{CompiledBinding SelectedPath.Configuration}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Purpose" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{CompiledBinding SelectedPath.Description}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{CompiledBinding Summary}" />
          <TextBlock Text="{CompiledBinding ManagedMemorySummary}" />
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid x:Name="OptimizedFlatCellPathsGrid"
              Grid.Row="3"
              AutomationProperties.Name="Optimized flat cell paths workload grid"
              AutoGenerateColumns="False"
              AutoScrollToSelectedItem="True"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              Classes.optimized-cell-path="{CompiledBinding UseOptimizedTheme}"
              ColumnDefinitionsSource="{CompiledBinding ActiveColumns}"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              IsReadOnly="True"
              ItemsSource="{CompiledBinding Items}"
              RowHeight="28"
              SelectedItem="{CompiledBinding SelectedItem, Mode=TwoWay}"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              UseLogicalScrollable="True" />
  </Grid>
</UserControl>
