<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Avalonia.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Explicit opt-in themes for read-mostly, control-count-sensitive grids. -->
      <ControlTheme x:Key="DataGridOptimizedCellTheme" TargetType="DataGridCell">
        <Setter Property="Background" Value="{StaticResource DataGridCellBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{StaticResource DataGridCellFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource DataGridCellMinHeight}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:searchmatch">
          <Setter Property="Background" Value="{StaticResource DataGridSearchMatchBrush}" />
          <Setter Property="Foreground" Value="{StaticResource DataGridSearchMatchForegroundBrush}" />
        </Style>
        <Style Selector="^:searchcurrent">
          <Setter Property="Background" Value="{StaticResource DataGridSearchCurrentBrush}" />
          <Setter Property="Foreground" Value="{StaticResource DataGridSearchMatchForegroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedUnfocusedBackgroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected:pointerover">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedHoveredUnfocusedBackgroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected:focus">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected:pointerover:focus">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedHoveredBackgroundBrush}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="DataGridOptimizedDrawingCellTheme"
                    TargetType="controls:DataGridCustomDrawingCell">
        <Setter Property="Margin" Value="{StaticResource DataGridCellTextBlockMargin}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel IsVisible="False" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="DataGridOptimizedDirectTextCellTheme"
                    TargetType="controls:DataGridDirectTextCell">
        <Setter Property="Background" Value="{StaticResource DataGridCellBackgroundBrush}" />
        <Setter Property="Padding" Value="{StaticResource DataGridCellTextBlockMargin}" />
        <Setter Property="FontSize" Value="{StaticResource DataGridCellFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource DataGridCellMinHeight}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <TextBlock Text="{TemplateBinding Value}"
                         Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         FontStyle="{TemplateBinding FontStyle}"
                         FontWeight="{TemplateBinding FontWeight}"
                         VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:searchmatch">
          <Setter Property="Background" Value="{StaticResource DataGridSearchMatchBrush}" />
          <Setter Property="Foreground" Value="{StaticResource DataGridSearchMatchForegroundBrush}" />
        </Style>
        <Style Selector="^:searchcurrent">
          <Setter Property="Background" Value="{StaticResource DataGridSearchCurrentBrush}" />
          <Setter Property="Foreground" Value="{StaticResource DataGridSearchMatchForegroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedUnfocusedBackgroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected:pointerover">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedHoveredUnfocusedBackgroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected:focus">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected:pointerover:focus">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedHoveredBackgroundBrush}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="DataGridOptimizedDirectHierarchicalCellTheme"
                    TargetType="controls:DataGridDirectHierarchicalCell">
        <Setter Property="Background" Value="{StaticResource DataGridCellBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource DataGridCellFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource DataGridCellMinHeight}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="Auto,*">
                <ToggleButton x:Name="PART_Expander"
                              Width="{StaticResource DataGridHierarchicalExpanderSize}"
                              Height="{StaticResource DataGridHierarchicalExpanderSize}"
                              Theme="{StaticResource DataGridHierarchicalExpanderTheme}"
                              IsEnabled="{TemplateBinding IsExpandable}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{TemplateBinding IsExpanded}" />
                <ContentPresenter Grid.Column="1"
                                  Margin="{StaticResource DataGridHierarchicalPresenterContentMargin}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:cell-selected">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedUnfocusedBackgroundBrush}" />
        </Style>
        <Style Selector="^:cell-selected:focus">
          <Setter Property="Background" Value="{StaticResource DataGridCellSelectedBackgroundBrush}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="DataGridOptimizedRowTheme" TargetType="DataGridRow">
        <Setter Property="Background" Value="{Binding $parent[DataGrid].RowBackground}" />
        <Setter Property="Template">
          <ControlTemplate>
            <DataGridFrozenGrid Name="PART_Root"
                                Background="{TemplateBinding Background}">
              <DataGridCellsPresenter Name="PART_CellsPresenter"
                                      DataGridFrozenGrid.IsFrozen="True" />
            </DataGridFrozenGrid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:invalid">
          <Setter Property="Background" Value="{StaticResource DataGridRowInvalidBrush}" />
        </Style>
        <Style Selector="^:warning">
          <Setter Property="Background" Value="{StaticResource DataGridRowWarningBrush}" />
        </Style>
        <Style Selector="^:info">
          <Setter Property="Background" Value="{StaticResource DataGridRowInfoBrush}" />
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{StaticResource DataGridRowHoveredBackgroundBrush}" />
        </Style>
        <Style Selector="^:searchmatch">
          <Setter Property="Background" Value="{StaticResource DataGridSearchMatchBrush}" />
        </Style>
        <Style Selector="^:searchcurrent">
          <Setter Property="Background" Value="{StaticResource DataGridSearchCurrentBrush}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{StaticResource DataGridRowSelectedUnfocusedBackgroundBrush}" />
        </Style>
        <Style Selector="^:selected:pointerover">
          <Setter Property="Background" Value="{StaticResource DataGridRowSelectedHoveredUnfocusedBackgroundBrush}" />
        </Style>
        <Style Selector="^:selected:focus">
          <Setter Property="Background" Value="{StaticResource DataGridRowSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="^:selected:pointerover:focus">
          <Setter Property="Background" Value="{StaticResource DataGridRowSelectedHoveredBackgroundBrush}" />
        </Style>
        <Style Selector="^:dragging">
          <Setter Property="Opacity" Value="{StaticResource DataGridRowDraggingOpacity}" />
        </Style>
        <Style Selector="^:drag-over-inside">
          <Setter Property="Background" Value="{StaticResource DataGridRowDropIndicatorBrush}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="DataGridOptimizedColumnHeaderTheme" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackgroundBrush}" />
        <Setter Property="Padding" Value="{StaticResource DataGridColumnHeaderPadding}" />
        <Setter Property="FontSize" Value="{StaticResource DataGridColumnHeaderFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource DataGridColumnHeaderMinHeight}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
